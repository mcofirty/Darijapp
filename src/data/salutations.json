[
  {
    "id": "salutations-001",
    "latin": "salam",
    "arabe": "سلام",
    "fr": "salut, bonjour",
    "theme": "salutations",
    "niveau": 1,
    "prononciation": "sa-lam : comme en français, avec des « a » bien ouverts.",
    "audio": "",
    "exemple": {
      "latin": "salam, labas?",
      "arabe": "سلام، لاباس؟",
      "fr": "Salut, ça va ?",
      "audio": ""
    }
  },
  {
    "id": "salutations-002",
    "latin": "salam 3alikoum",
    "arabe": "السلام عليكم",
    "fr": "bonjour (formule complète)",
    "theme": "salutations",
    "niveau": 1,
    "prononciation": "sa-lam 3a-li-koum : le 3 (ع) est un « a » serré au fond de la gorge, comme si on l'étranglait légèrement.",
    "audio": "",
    "exemple": {
      "latin": "salam 3alikoum a lalla",
      "arabe": "السلام عليكم ألالة",
      "fr": "Bonjour madame",
      "audio": ""
    }
  },
  {
    "id": "salutations-003",
    "latin": "wa 3alikoum salam",
    "arabe": "وعليكم السلام",
    "fr": "bonjour (réponse)",
    "theme": "salutations",
    "niveau": 1,
    "prononciation": "wa 3a-li-koum sa-lam : même 3 (ع) serré de la gorge que dans salam 3alikoum.",
    "audio": "",
    "exemple": {
      "latin": "wa 3alikoum salam, mar7ba",
      "arabe": "وعليكم السلام، مرحبا",
      "fr": "Bonjour à vous, bienvenue",
      "audio": ""
    }
  },
  {
    "id": "salutations-004",
    "latin": "sba7 lkhir",
    "arabe": "صباح الخير",
    "fr": "bonjour (le matin)",
    "theme": "salutations",
    "niveau": 1,
    "prononciation": "sba7 l-khir : le 7 (ح) est un souffle chaud et sourd, comme pour embuer des lunettes ; le kh (خ) se racle comme la jota espagnole.",
    "audio": "",
    "exemple": {
      "latin": "sba7 lkhir a khouya",
      "arabe": "صباح الخير أخويا",
      "fr": "Bonjour mon frère",
      "audio": ""
    }
  },
  {
    "id": "salutations-005",
    "latin": "msa lkhir",
    "arabe": "مسا الخير",
    "fr": "bonsoir",
    "theme": "salutations",
    "niveau": 1,
    "prononciation": "msa l-khir : « m » et « s » collés sans voyelle entre eux ; kh (خ) raclé au fond de la gorge.",
    "audio": "",
    "exemple": {
      "latin": "msa lkhir, labas 3lik?",
      "arabe": "مسا الخير، لاباس عليك؟",
      "fr": "Bonsoir, tu vas bien ?",
      "audio": ""
    }
  },
  {
    "id": "salutations-006",
    "latin": "labas",
    "arabe": "لاباس",
    "fr": "ça va / ça va ?",
    "theme": "salutations",
    "niveau": 1,
    "prononciation": "la-bas : facile, comme « là-bas » en français. Monte la voix à la fin pour en faire une question.",
    "audio": "",
    "exemple": {
      "latin": "labas 3lik?",
      "arabe": "لاباس عليك؟",
      "fr": "Tu vas bien ?",
      "audio": ""
    }
  },
  {
    "id": "salutations-007",
    "latin": "l7amdoulillah",
    "arabe": "الحمد لله",
    "fr": "Dieu merci (ça va bien)",
    "theme": "salutations",
    "niveau": 1,
    "prononciation": "l-7am-dou-lil-lah : le 7 (ح) est un souffle chaud venu de la gorge, sans raclement.",
    "audio": "",
    "exemple": {
      "latin": "labas, l7amdoulillah, w nta?",
      "arabe": "لاباس، الحمد لله، ونتا؟",
      "fr": "Ça va, Dieu merci, et toi ?",
      "audio": ""
    }
  },
  {
    "id": "salutations-008",
    "latin": "kidayr?",
    "arabe": "كيداير؟",
    "fr": "comment vas-tu ? (à un homme)",
    "theme": "salutations",
    "niveau": 1,
    "prononciation": "ki-dayr : le « r » est roulé du bout de la langue. À une femme on dit kidayra.",
    "audio": "",
    "exemple": {
      "latin": "kidayr a sa7bi?",
      "arabe": "كيداير أصاحبي؟",
      "fr": "Comment tu vas, mon ami ?",
      "audio": ""
    }
  },
  {
    "id": "salutations-009",
    "latin": "bikhir",
    "arabe": "بخير",
    "fr": "bien",
    "theme": "salutations",
    "niveau": 1,
    "prononciation": "bi-khir : le kh (خ) se racle au fond de la gorge, comme dans « Bach » en allemand.",
    "audio": "",
    "exemple": {
      "latin": "ana bikhir, chokran",
      "arabe": "أنا بخير، شكرا",
      "fr": "Je vais bien, merci",
      "audio": ""
    }
  },
  {
    "id": "salutations-010",
